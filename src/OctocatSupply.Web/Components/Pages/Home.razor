@page "/"
@rendermode InteractiveServer
@inject ThemeService ThemeService
@implements IDisposable

<PageTitle>OctoCAT Supply - Smart Cat Technology</PageTitle>

<div class="@(ThemeService.DarkMode ? "bg-dark text-light" : "bg-white text-gray-800") relative transition-colors duration-300">

    @* Hero Section *@
    <div class="relative px-4 sm:px-6 lg:px-8 pt-8">
        <div class="relative py-4">
            <div class="w-full max-w-7xl mx-auto">
                <img src="/images/hero.png"
                     alt="Smart Cat Products powered by AI"
                     class="w-full h-auto rounded-lg" />
            </div>

            <div class="absolute inset-0 flex items-start pt-16 justify-end max-w-7xl mx-auto px-10 sm:px-12 lg:px-14 mr-[-1rem]">
                <div class="@(ThemeService.DarkMode ? "bg-dark/60" : "bg-white/60") max-w-2xl backdrop-blur-sm p-8 rounded-xl shadow-[0_0_25px_rgba(118,184,82,0.5)] transition-colors duration-300">
                    <div class="@(ThemeService.DarkMode ? "bg-primary/20" : "bg-primary/30") inline-block px-4 py-2 rounded-full mb-4 border border-primary/40">
                        <span class="text-primary font-semibold">Powered by Advanced AI</span>
                    </div>
                    <h1 class="@(ThemeService.DarkMode ? "text-white" : "text-gray-800") text-5xl font-bold mb-6 leading-tight transition-colors duration-300">
                        Welcome to<br />
                        <span class="bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent">OctoCAT Supply</span>
                    </h1>
                    <p class="@(ThemeService.DarkMode ? "text-gray-200" : "text-gray-700") mb-8 text-lg transition-colors duration-300">
                        Your one-stop shop for premium smart cat technology. Our AI-powered products learn
                        from your feline friend's behavior to provide personalized experiences, health insights,
                        and next-level entertainment.
                    </p>
                    <a href="/products"
                       class="bg-primary hover:bg-accent text-white px-8 py-3 rounded-md font-medium transition-colors inline-block">
                        Shop Now
                    </a>
                </div>
            </div>
        </div>

        @* Product Category Cards *@
        <div class="py-16">
            <h2 class="@(ThemeService.DarkMode ? "text-white" : "text-gray-800") text-3xl font-bold text-center mb-12 transition-colors duration-300">
                Smart Solutions for Modern Cats
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl mx-auto">
                @foreach (var category in _categories)
                {
                    <div class="@(ThemeService.DarkMode ? "bg-gray-800" : "bg-white") rounded-lg p-6 shadow-lg hover:shadow-[0_0_15px_rgba(118,184,82,0.3)] transition-all duration-300">
                        <div class="text-primary text-4xl mb-4">@category.Icon</div>
                        <h3 class="@(ThemeService.DarkMode ? "text-white" : "text-gray-800") text-xl font-bold mb-2 transition-colors duration-300">
                            @category.Title
                        </h3>
                        <p class="@(ThemeService.DarkMode ? "text-gray-300" : "text-gray-600") transition-colors duration-300">
                            @category.Description
                        </p>
                    </div>
                }
            </div>
        </div>

        @* Featured Products Gallery *@
        <div class="py-16">
            <h2 class="@(ThemeService.DarkMode ? "text-white" : "text-gray-800") text-3xl font-bold text-center mb-12 transition-colors duration-300">
                Featured Products
            </h2>
            <div class="flex gap-6 overflow-x-auto pb-4 max-w-7xl mx-auto snap-x snap-mandatory scrollbar-hide px-2">
                @foreach (var product in _featuredProducts)
                {
                    <div class="@(ThemeService.DarkMode ? "bg-gray-800 border-gray-700" : "bg-white border-gray-200") min-w-[280px] max-w-[280px] rounded-lg border shadow-lg hover:shadow-[0_0_15px_rgba(118,184,82,0.3)] transition-all duration-300 snap-center flex-shrink-0">
                        <img src="@product.Image"
                             alt="@product.Name"
                             class="w-full h-48 object-cover rounded-t-lg" />
                        <div class="p-4">
                            <h3 class="@(ThemeService.DarkMode ? "text-white" : "text-gray-800") text-lg font-bold mb-1 transition-colors duration-300">
                                @product.Name
                            </h3>
                            <p class="@(ThemeService.DarkMode ? "text-gray-400" : "text-gray-500") text-sm mb-3 transition-colors duration-300">
                                @product.Description
                            </p>
                            <div class="flex items-center justify-between">
                                <span class="text-primary font-bold text-lg">@product.Price.ToString("C")</span>
                                <a href="/products"
                                   class="bg-primary hover:bg-accent text-white text-sm px-4 py-2 rounded-md transition-colors">
                                    View
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private record CategoryCard(string Icon, string Title, string Description);
    private record FeaturedProduct(string Name, string Description, string Image, decimal Price);

    private readonly List<CategoryCard> _categories = new()
    {
        new("🍽️", "Smart Feeders", "AI-powered feeding solutions for your feline friends"),
        new("💊", "Health Tech", "Monitor your cat's wellness with cutting-edge technology"),
        new("🎮", "Entertainment", "Keep your cat entertained with interactive gadgets")
    };

    private readonly List<FeaturedProduct> _featuredProducts = new()
    {
        new("SmartFeeder Pro", "AI-powered automatic feeder with portion control", "/images/feeder.png", 149.99m),
        new("ChirpCam 360", "Interactive camera with treat dispenser and laser", "/images/chirp-cam.png", 199.99m),
        new("Smart Collar+", "GPS tracking with health monitoring sensors", "/images/smart-collar.png", 89.99m),
        new("CatFlix Station", "Streaming entertainment system for cats", "/images/catflix.png", 129.99m)
    };

    protected override void OnInitialized()
    {
        ThemeService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }
}

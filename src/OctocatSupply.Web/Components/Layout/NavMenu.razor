@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@inject AuthService AuthService
@implements IDisposable

<nav class="@(ThemeService.DarkMode ? "bg-dark/95" : "bg-white/95") backdrop-blur-sm fixed w-full z-50 shadow-md transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex items-center justify-between h-16">
            <div class="flex-shrink-0 flex items-center">
                <a href="/" class="flex items-center">
                    <img src="copilot.png" alt="Copilot icon" class="h-8 w-auto" />
                    <div class="ml-2">
                        <span class="@(ThemeService.DarkMode ? "text-light" : "text-gray-800") text-xl font-bold">
                            OctoCAT Supply
                        </span>
                        <span class="block text-xs text-primary">Smart Cat Tech, Powered by AI</span>
                    </div>
                </a>
            </div>

            <div class="hidden md:block">
                <div class="ml-10 flex items-baseline space-x-4">
                    <NavLink href="" Match="NavLinkMatch.All"
                             class="@($"{NavLinkClass()} px-3 py-2 rounded-md text-sm font-medium transition-colors")">
                        Home
                    </NavLink>
                    <NavLink href="products"
                             class="@($"{NavLinkClass()} px-3 py-2 rounded-md text-sm font-medium transition-colors")">
                        Products
                    </NavLink>
                    <NavLink href="about"
                             class="@($"{NavLinkClass()} px-3 py-2 rounded-md text-sm font-medium transition-colors")">
                        About us
                    </NavLink>

                    @if (AuthService.IsAdmin)
                    {
                        <div class="relative">
                            <button @onclick="ToggleAdminMenu"
                                    class="@NavLinkClass() px-3 py-2 rounded-md text-sm font-medium flex items-center transition-colors">
                                Admin
                                <svg class="@($"ml-1 h-4 w-4 transform {(adminMenuOpen ? "rotate-180" : "")} transition-transform")"
                                     fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                     viewBox="0 0 24 24" stroke="currentColor">
                                    <path d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </button>
                            @if (adminMenuOpen)
                            {
                                <div class="@(ThemeService.DarkMode ? "bg-dark" : "bg-white") absolute right-0 mt-2 w-48 rounded-md shadow-lg ring-1 ring-black ring-opacity-5 transition-colors">
                                    <div class="py-1">
                                        <a href="admin/products" @onclick="() => adminMenuOpen = false"
                                           class="@(ThemeService.DarkMode ? "text-light hover:bg-primary hover:text-white" : "text-gray-700 hover:bg-primary hover:text-white") block px-4 py-2 text-sm transition-colors">
                                            Manage Products
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="flex items-center space-x-4">
                <button @onclick="ThemeService.ToggleTheme"
                        class="p-2 rounded-full focus:outline-none transition-colors"
                        aria-label="Toggle dark/light mode">
                    @if (ThemeService.DarkMode)
                    {
                        @* Sun icon for dark mode *@
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-yellow-300" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd"
                                  d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                                  clip-rule="evenodd" />
                        </svg>
                    }
                    else
                    {
                        @* Moon icon for light mode *@
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-700" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
                        </svg>
                    }
                </button>

                @if (AuthService.IsLoggedIn)
                {
                    <span class="@(ThemeService.DarkMode ? "text-light" : "text-gray-700") text-sm transition-colors">
                        @if (AuthService.IsAdmin)
                        {
                            <span class="text-primary">(Admin) </span>
                        }
                        Welcome!
                    </span>
                    <button @onclick="AuthService.Logout"
                            class="@NavLinkClass() px-3 py-2 rounded-md text-sm font-medium transition-colors">
                        Logout
                    </button>
                }
                else
                {
                    <a href="login"
                       class="bg-primary hover:bg-accent text-white px-4 py-2 rounded-md text-sm font-medium transition-colors">
                        Login
                    </a>
                }
            </div>
        </div>
    </div>
</nav>
@* Spacer to offset fixed navbar *@
<div class="h-16"></div>

@code {
    private bool adminMenuOpen = false;

    protected override void OnInitialized()
    {
        ThemeService.OnChange += StateHasChanged;
        AuthService.OnChange += StateHasChanged;
    }

    private void ToggleAdminMenu()
    {
        adminMenuOpen = !adminMenuOpen;
    }

    private string NavLinkClass() =>
        ThemeService.DarkMode
            ? "text-light hover:text-primary"
            : "text-gray-700 hover:text-primary";

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
        AuthService.OnChange -= StateHasChanged;
    }
}
